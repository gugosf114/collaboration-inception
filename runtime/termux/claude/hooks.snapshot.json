{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 /root/.claude/hooks/george-core-contract.py",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/root/.claude/hooks/answer-length.sh",
          "timeout": 15,
          "statusMessage": "Answer length check"
        },
        {
          "type": "command",
          "command": "/root/.claude/hooks/plain-words.sh",
          "timeout": 15,
          "statusMessage": "Plain words check"
        }
      ]
    }
  ]
}
